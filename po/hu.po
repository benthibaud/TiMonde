msgid ""
"<small>• Edit the <b>#</b> or use <b>Move up / Move down</b> to order groups.\n"
"• <b>Double-click a group</b> (or Open) to sort its stations and separators.\n"
"• Use <b>Transfer...</b> to merge or move content to another group.\n"
"• Use <b>New group</b> to add a station folder.</small>"
msgstr ""
"<small>• Módosítsa a <b>#</b> értéket, vagy használja a <b>Mozgatás fel/le</b> parancsot a csoportok rendezéséhez. \n"
" • <b>Kattintson duplán egy csoportra</b> (vagy Megnyitás) a rádiók és elosztók rendezéséhez. \n"
" • Használja az <b>Átvitel...</b> funkciót a tartalom egyesítéséhez vagy másik csoportba való áthelyezéséhez. \n"
" • Az <b>Új csoport</b> használatával adjon hozzá rádiókat tartalmazó mappát.</small>"

msgid ""
"<small>• Edit the <b>#</b> or use <b>Move up / Move down</b> to order stations.\n"
"• Click <b>Check streams</b> to find broken links (red) and repair them.\n"
"• Click <b>Repair stream...</b> to search Radio-Browser for a working replacement stream.\n"
"• Click <b>Separator</b> to insert a section header.</small>"
msgstr ""
"<small>• Módosítsa a <b>#</b> értéket, vagy használja a <b>Mozgatás fel/le</b> parancsot a rádiók rendezéséhez. \n"
" • Kattintson a <b>Hírcsatornák ellenőrzése</b> lehetőségre az elhalt hivatkozások (piros) észleléséhez és javításához. \n"
" • Kattintson a <b>Stream javítása...</b> elemre, ha a Radio-Browserben keres egy csere aktív adatfolyamot. \n"
" • Kattintson az <b>Elválasztó</b> elemre egy szakaszfejléc beszúrásához.</small>"

msgid "<i>Sélectionnez un fichier ou un exemple ci-dessus.</i>"
msgstr "<i>Válasszon ki egy fájlt vagy példát fent.</i>"

msgid ""
"<small>• Modifiez le <b>#</b> ou utilisez <b>Monter / Descendre</b> pour ordonner les groupes.\n"
"• <b>Double-cliquez sur un groupe</b> (ou Ouvrir) pour trier ses radios et séparateurs.\n"
"• Utilisez <b>Déplacer vers...</b> pour fusionner ou déplacer du contenu.\n"
"• Utilisez <b>Nouveau groupe</b> pour créer un dossier de radios.</small>"
msgstr ""
"<small>• Módosítsa a <b>#</b> értéket, vagy használja a <b>Mozgatás fel/le</b> parancsot a csoportok rendezéséhez. \n"
" • <b>Kattintson duplán egy csoportra</b> (vagy Megnyitás) a rádiók és elválasztók rendezéséhez. \n"
" • Használja az <b>Áthelyezés ide...</b> funkciót a tartalom egyesítéséhez vagy áthelyezéséhez. \n"
" • Az <b>Új csoport</b> használatával hozzon létre egy mappát rádiókból.</small>"

msgid ""
"<small>• Modifiez le <b>#</b> ou utilisez <b>Monter / Descendre</b> pour ordonner les radios.\n"
"• Cliquez sur <b>Vérifier les flux</b> pour repérer les liens hors-ligne (en rouge).\n"
"• Cliquez sur <b>Réparer le flux...</b> pour chercher un flux de remplacement actif.\n"
"• Cliquez sur <b>Séparateur</b> pour insérer un intertitre ou trait de séparation.</small>"
msgstr ""
"<small>• Változtassa meg a <b>#</b> értéket, vagy használja a <b>Move Up/Le</b> parancsot a rádiók megrendeléséhez. \n"
" • Kattintson a <b>Hírcsatornák ellenőrzése</b> lehetőségre az offline hivatkozások megkereséséhez (pirossal). \n"
" • Kattintson a <b>Stream javítása...</b> elemre az aktív cserefolyam kereséséhez. \n"
" • Kattintson az <b>Elválasztóra</b> felirat vagy elválasztó sor beszúrásához.</small>"

